					clock-names = "pclk", "sclk", "sclk_sel", "lrclk", "lrclk_sel";
					status = "disabled";
				};

				audio-controller@540 {
					compatible = "amlogic,g12a-tdmout";
					reg = <0x00 0x540 0x00 0x40>;
					sound-name-prefix = "TDMOUT_B";
					resets = <0x17 0x0d>;
					clocks = <0x17 0x24 0x17 0x80 0x17 0x79 0x17 0x87 0x17 0x87>;
					clock-names = "pclk", "sclk", "sclk_sel", "lrclk", "lrclk_sel";
